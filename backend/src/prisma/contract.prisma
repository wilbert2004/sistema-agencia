// use prisma-next
// Contract inferred from the live database schema. Edit as needed, then run `prisma contract emit`.

model Roles {
  idRol       Int         @id(map: "pk_roles") @default(autoincrement()) @map("id_rol")
  nombre      VarChar(50) @unique(map: "uq_roles_nombre")
  descripcion String?
  usuarios    Usuarios[]

  @@map("roles")
}

model Usuarios {
  idUsuario      Int           @id(map: "pk_usuarios") @default(autoincrement()) @map("id_usuario")
  idRol          Int           @map("id_rol")
  nombre         VarChar(150)
  correo         VarChar(150)  @unique(map: "uq_usuarios_correo")
  contrasenaHash VarChar(255)  @map("contrasena_hash")
  activo         Boolean       @default(true)
  fechaRegistro  Timestamp     @default(now()) @map("fecha_registro")
  clientes       Clientes?
  documentos     Documentos[]
  entregables    Entregables[]
  trabajadores   Trabajadores?
  roles          Roles         @relation(fields: [idRol], references: [idRol], onDelete: Restrict, map: "fk_usuarios_roles", index: false)

  @@map("usuarios")
}

model Clientes {
  idCliente  Int           @id(map: "pk_clientes") @default(autoincrement()) @map("id_cliente")
  idUsuario  Int           @unique(map: "uq_clientes_usuario") @map("id_usuario")
  empresa    VarChar(150)?
  telefono   VarChar(20)
  direccion  String
  propuestas Propuestas[]
  proyectos  Proyectos[]
  usuarios   Usuarios      @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, map: "fk_clientes_usuario")

  @@map("clientes")
}

model Propuestas {
  idPropuesta       Int                @id(map: "pk_propuestas") @default(autoincrement()) @map("id_propuesta")
  idCliente         Int                @map("id_cliente")
  nombre            VarChar(150)
  descripcion       String?
  fechaCreacion     Timestamp          @default(now()) @map("fecha_creacion")
  fechaVencimiento  Date?              @map("fecha_vencimiento")
  subtotal          Numeric(12, 2)     @default(0)
  impuestos         Numeric(12, 2)     @default(0)
  total             Numeric(12, 2)     @default(0)
  estado            VarChar(30)        @default("pendiente")
  propuestaDetalles PropuestaDetalle[]
  proyectos         Proyectos[]
  clientes          Clientes           @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict, map: "fk_propuestas_cliente")

  @@index([idCliente], map: "idx_propuestas_cliente")
  @@check(expression: "((estado)::text = ANY ((ARRAY['pendiente'::character varying, 'enviada'::character varying, 'aceptada'::character varying, 'rechazada'::character varying, 'vencida'::character varying, 'cancelada'::character varying])::text[]))", map: "chk_propuestas_estado")
  @@check(expression: "(impuestos >= (0)::numeric)", map: "chk_propuestas_impuestos")
  @@check(expression: "(subtotal >= (0)::numeric)", map: "chk_propuestas_subtotal")
  @@check(expression: "(total >= (0)::numeric)", map: "chk_propuestas_total")
  @@map("propuestas")
}

model Proyectos {
  idProyecto        Int                @id(map: "pk_proyectos") @default(autoincrement()) @map("id_proyecto")
  idCliente         Int                @map("id_cliente")
  idPropuesta       Int?               @map("id_propuesta")
  nombreProyecto    VarChar(150)       @map("nombre_proyecto")
  descripcion       String?
  fechaInicio       Date               @map("fecha_inicio")
  fechaFinEstimada  Date?              @map("fecha_fin_estimada")
  estado            VarChar(30)        @default("planificacion")
  asignaciones      Asignaciones[]
  documentos        Documentos[]
  pagos             Pagos[]
  proyectoEtapas    ProyectoEtapa[]
  proyectoServicios ProyectoServicio[]
  clientes          Clientes           @relation(fields: [idCliente], references: [idCliente], onDelete: Restrict, map: "fk_proyectos_cliente")
  propuestas        Propuestas?        @relation(fields: [idPropuesta], references: [idPropuesta], onDelete: SetNull, map: "fk_proyectos_propuesta")

  @@index([idCliente], map: "idx_proyectos_cliente")
  @@index([idPropuesta], map: "idx_proyectos_propuesta")
  @@check(expression: "((estado)::text = ANY ((ARRAY['planificacion'::character varying, 'en_progreso'::character varying, 'pausado'::character varying, 'finalizado'::character varying, 'cancelado'::character varying])::text[]))", map: "chk_proyectos_estado")
  @@check(expression: "((fecha_fin_estimada IS NULL) OR (fecha_fin_estimada >= fecha_inicio))", map: "chk_proyectos_fechas")
  @@map("proyectos")
}

model Trabajadores {
  idTrabajador            Int                      @id(map: "pk_trabajadores") @default(autoincrement()) @map("id_trabajador")
  idUsuario               Int                      @unique(map: "uq_trabajadores_usuario") @map("id_usuario")
  puesto                  VarChar(100)
  asignaciones            Asignaciones[]
  trabajadorEspecialidads TrabajadorEspecialidad[]
  usuarios                Usuarios                 @relation(fields: [idUsuario], references: [idUsuario], onDelete: Restrict, map: "fk_trabajadores_usuario")

  @@map("trabajadores")
}

model Asignaciones {
  idAsignacion    Int           @id(map: "pk_asignaciones") @default(autoincrement()) @map("id_asignacion")
  idProyecto      Int           @map("id_proyecto")
  idTrabajador    Int           @map("id_trabajador")
  rolEnProyecto   VarChar(100)  @map("rol_en_proyecto")
  fechaAsignacion Date          @default(dbgenerated("CURRENT_DATE")) @map("fecha_asignacion")
  estado          VarChar(30)   @default("activo")
  actividades     Actividades[]
  proyectos       Proyectos     @relation(fields: [idProyecto], references: [idProyecto], onDelete: Cascade, map: "fk_asignaciones_proyecto")
  trabajadores    Trabajadores  @relation(fields: [idTrabajador], references: [idTrabajador], onDelete: Restrict, map: "fk_asignaciones_trabajador")

  @@unique([idProyecto, idTrabajador], map: "uq_asignacion_proyecto_trabajador")
  @@index([idProyecto], map: "idx_asignaciones_proyecto")
  @@index([idTrabajador], map: "idx_asignaciones_trabajador")
  @@check(expression: "((estado)::text = ANY ((ARRAY['activo'::character varying, 'finalizado'::character varying, 'cancelado'::character varying])::text[]))", map: "chk_asignaciones_estado")
  @@map("asignaciones")
}

model Actividades {
  idActividad   Int           @id(map: "pk_actividades") @default(autoincrement()) @map("id_actividad")
  idAsignacion  Int           @map("id_asignacion")
  descripcion   String
  fechaInicio   Date          @map("fecha_inicio")
  fechaFin      Date?         @map("fecha_fin")
  avance        Numeric(5, 2) @default(0)
  estado        VarChar(30)   @default("pendiente")
  observaciones String?
  documentos    Documentos[]
  entregables   Entregables[]
  asignaciones  Asignaciones  @relation(fields: [idAsignacion], references: [idAsignacion], onDelete: Cascade, map: "fk_actividades_asignacion")

  @@index([idAsignacion], map: "idx_actividades_asignacion")
  @@check(expression: "((avance >= (0)::numeric) AND (avance <= (100)::numeric))", map: "chk_actividades_avance")
  @@check(expression: "((estado)::text = ANY ((ARRAY['pendiente'::character varying, 'en_progreso'::character varying, 'completada'::character varying, 'bloqueada'::character varying, 'cancelada'::character varying])::text[]))", map: "chk_actividades_estado")
  @@check(expression: "((fecha_fin IS NULL) OR (fecha_fin >= fecha_inicio))", map: "chk_actividades_fechas")
  @@map("actividades")
}

model Entregables {
  idEntregable       Int          @id(map: "pk_entregables") @default(autoincrement()) @map("id_entregable")
  idActividad        Int          @map("id_actividad")
  nombre             VarChar(150)
  descripcion        String?
  fechaEntrega       Date?        @map("fecha_entrega")
  estado             VarChar(30)  @default("pendiente")
  aprobadoPorUsuario Int?         @map("aprobado_por_usuario")
  fechaAprobacion    Timestamp?   @map("fecha_aprobacion")
  observaciones      String?
  documentos         Documentos[]
  actividades        Actividades  @relation(fields: [idActividad], references: [idActividad], onDelete: Cascade, map: "fk_entregables_actividad")
  usuarios           Usuarios?    @relation(fields: [aprobadoPorUsuario], references: [idUsuario], onDelete: SetNull, map: "fk_entregables_aprobador", index: false)

  @@index([idActividad], map: "idx_entregables_actividad")
  @@check(expression: "((estado)::text = ANY ((ARRAY['pendiente'::character varying, 'en_revision'::character varying, 'aprobado'::character varying, 'requiere_cambios'::character varying, 'rechazado'::character varying])::text[]))", map: "chk_entregables_estado")
  @@map("entregables")
}

model Documentos {
  idDocumento      Int          @id(map: "pk_documentos") @default(autoincrement()) @map("id_documento")
  idProyecto       Int          @map("id_proyecto")
  idActividad      Int?         @map("id_actividad")
  idEntregable     Int?         @map("id_entregable")
  subidoPorUsuario Int          @map("subido_por_usuario")
  tipo             VarChar(100)
  nombreArchivo    VarChar(255) @map("nombre_archivo")
  rutaArchivo      String       @map("ruta_archivo")
  fechaSubida      Timestamp    @default(now()) @map("fecha_subida")
  actividades      Actividades? @relation(fields: [idActividad], references: [idActividad], onDelete: SetNull, map: "fk_documentos_actividad", index: false)
  entregables      Entregables? @relation(fields: [idEntregable], references: [idEntregable], onDelete: SetNull, map: "fk_documentos_entregable")
  proyectos        Proyectos    @relation(fields: [idProyecto], references: [idProyecto], onDelete: Cascade, map: "fk_documentos_proyecto")
  usuarios         Usuarios     @relation(fields: [subidoPorUsuario], references: [idUsuario], onDelete: Restrict, map: "fk_documentos_usuario", index: false)

  @@index([idEntregable], map: "idx_documentos_entregable")
  @@index([idProyecto], map: "idx_documentos_proyecto")
  @@map("documentos")
}

model Especialidades {
  idEspecialidad          Int                      @id(map: "pk_especialidades") @default(autoincrement()) @map("id_especialidad")
  nombreEspecialidad      VarChar(100)             @unique(map: "uq_especialidades_nombre") @map("nombre_especialidad")
  trabajadorEspecialidads TrabajadorEspecialidad[]

  @@map("especialidades")
}

model Etapas {
  idEtapa        Int             @id(map: "pk_etapas") @default(autoincrement()) @map("id_etapa")
  nombreEtapa    VarChar(100)    @unique(map: "uq_etapas_nombre") @map("nombre_etapa")
  descripcion    String?
  proyectoEtapas ProyectoEtapa[]

  @@map("etapas")
}

model Pagos {
  idPago                Int            @id(map: "pk_pagos") @default(autoincrement()) @map("id_pago")
  idProyecto            Int            @map("id_proyecto")
  monto                 Numeric(12, 2)
  fechaPago             Date           @map("fecha_pago")
  estado                VarChar(30)    @default("registrado")
  metodoPago            VarChar(50)?   @map("metodo_pago")
  referenciaComprobante VarChar(100)?  @map("referencia_comprobante")
  observaciones         String?
  proyectos             Proyectos      @relation(fields: [idProyecto], references: [idProyecto], onDelete: Restrict, map: "fk_pagos_proyecto")

  @@index([idProyecto], map: "idx_pagos_proyecto")
  @@check(expression: "((estado)::text = ANY ((ARRAY['pendiente'::character varying, 'registrado'::character varying, 'confirmado'::character varying, 'rechazado'::character varying, 'cancelado'::character varying])::text[]))", map: "chk_pagos_estado")
  @@check(expression: "(monto > (0)::numeric)", map: "chk_pagos_monto")
  @@map("pagos")
}

model Servicios {
  idServicio        Int                @id(map: "pk_servicios") @default(autoincrement()) @map("id_servicio")
  nombreServicio    VarChar(100)       @unique(map: "uq_servicios_nombre") @map("nombre_servicio")
  descripcion       String?
  precioBase        Numeric(12, 2)     @map("precio_base")
  propuestaDetalles PropuestaDetalle[]
  proyectoServicios ProyectoServicio[]

  @@check(expression: "(precio_base >= (0)::numeric)", map: "chk_servicios_precio")
  @@map("servicios")
}

model PropuestaDetalle {
  idPropuestaDetalle Int            @id(map: "pk_propuesta_detalle") @default(autoincrement()) @map("id_propuesta_detalle")
  idPropuesta        Int            @map("id_propuesta")
  idServicio         Int            @map("id_servicio")
  cantidad           Int            @default(1)
  precioUnitario     Numeric(12, 2) @map("precio_unitario")
  subtotal           Numeric(12, 2)
  propuestas         Propuestas     @relation(fields: [idPropuesta], references: [idPropuesta], onDelete: Cascade, map: "fk_propuesta_detalle_propuesta", index: false)
  servicios          Servicios      @relation(fields: [idServicio], references: [idServicio], onDelete: Restrict, map: "fk_propuesta_detalle_servicio", index: false)

  @@check(expression: "(cantidad > 0)", map: "chk_propuesta_detalle_cantidad")
  @@check(expression: "(precio_unitario >= (0)::numeric)", map: "chk_propuesta_detalle_precio")
  @@check(expression: "(subtotal >= (0)::numeric)", map: "chk_propuesta_detalle_subtotal")
  @@map("propuesta_detalle")
}

model ProyectoEtapa {
  idProyectoEtapa Int         @id(map: "pk_proyecto_etapa") @default(autoincrement()) @map("id_proyecto_etapa")
  idProyecto      Int         @map("id_proyecto")
  idEtapa         Int         @map("id_etapa")
  fechaInicio     Date        @map("fecha_inicio")
  fechaFin        Date?       @map("fecha_fin")
  estado          VarChar(30) @default("pendiente")
  etapas          Etapas      @relation(fields: [idEtapa], references: [idEtapa], onDelete: Restrict, map: "fk_proyecto_etapa_etapa")
  proyectos       Proyectos   @relation(fields: [idProyecto], references: [idProyecto], onDelete: Cascade, map: "fk_proyecto_etapa_proyecto")

  @@index([idEtapa], map: "idx_proyecto_etapa_etapa")
  @@index([idProyecto], map: "idx_proyecto_etapa_proyecto")
  @@check(expression: "((estado)::text = ANY ((ARRAY['pendiente'::character varying, 'en_progreso'::character varying, 'completada'::character varying, 'cancelada'::character varying])::text[]))", map: "chk_proyecto_etapa_estado")
  @@check(expression: "((fecha_fin IS NULL) OR (fecha_fin >= fecha_inicio))", map: "chk_proyecto_etapa_fechas")
  @@map("proyecto_etapa")
}

model ProyectoServicio {
  idProyecto     Int            @map("id_proyecto")
  idServicio     Int            @map("id_servicio")
  cantidad       Int            @default(1)
  precioAcordado Numeric(12, 2) @map("precio_acordado")
  proyectos      Proyectos      @relation(fields: [idProyecto], references: [idProyecto], onDelete: Cascade, map: "fk_ps_proyecto", index: false)
  servicios      Servicios      @relation(fields: [idServicio], references: [idServicio], onDelete: Restrict, map: "fk_ps_servicio")

  @@id([idProyecto, idServicio], map: "pk_proyecto_servicio")
  @@index([idServicio], map: "idx_proyecto_servicio_servicio")
  @@check(expression: "(cantidad > 0)", map: "chk_ps_cantidad")
  @@check(expression: "(precio_acordado >= (0)::numeric)", map: "chk_ps_precio")
  @@map("proyecto_servicio")
}

model TrabajadorEspecialidad {
  idTrabajador   Int            @map("id_trabajador")
  idEspecialidad Int            @map("id_especialidad")
  especialidades Especialidades @relation(fields: [idEspecialidad], references: [idEspecialidad], onDelete: Cascade, map: "fk_te_especialidad", index: false)
  trabajadores   Trabajadores   @relation(fields: [idTrabajador], references: [idTrabajador], onDelete: Cascade, map: "fk_te_trabajador", index: false)

  @@id([idTrabajador, idEspecialidad], map: "pk_trabajador_especialidad")
  @@map("trabajador_especialidad")
}
